{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/capability-catalog.json",
  "id": "iot",
  "title": "IoT capability catalog",
  "description": "Edge IoT capabilities for weighbridges, ANPR, RFID scanners, and gate controllers.",
  "capabilities": [
    {
      "id": "iot.device",
      "title": "Device telemetry",
      "servers": ["io.tradeops.mcp.iot-gateway"],
      "tools": ["device.status", "device.read"],
      "risk": "low",
      "subscriptions": ["resourceSubscriptions"]
    },
    {
      "id": "iot.zone",
      "title": "Zone topology",
      "servers": ["io.tradeops.mcp.iot-gateway"],
      "tools": ["zone.graph"],
      "risk": "low",
      "ui": true
    }
  ]
}
