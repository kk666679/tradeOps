{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/auth-provider.json",
  "id": "entra-id",
  "title": "Microsoft Entra ID",
  "description": "Enterprise-managed authorization via Entra ID with SCIM provisioning and group-to-scope mapping.",
  "type": "oauth2",
  "issuer": "https://login.microsoftonline.com/{tenantId}/v2.0",
  "authorizationEndpoint": "https://login.microsoftonline.com/{tenantId}/oauth2/v2.0/authorize",
  "tokenEndpoint": "https://login.microsoftonline.com/{tenantId}/oauth2/v2.0/token",
  "jwksUri": "https://login.microsoftonline.com/{tenantId}/discovery/v2.0/keys",
  "clientRegistration": "cimd",
  "pkce": "S256",
  "resourceIndicators": true,
  "issuerValidation": "RFC9207",
  "enterpriseManaged": {
    "scim": true,
    "groupToScopeMapping": true
  }
}
