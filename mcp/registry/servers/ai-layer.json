{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/server.json",
  "name": "io.tradeops.mcp.ai-layer",
  "title": "AI Layer (Experimental)",
  "description": "Optional AI: RAG over cargo documents, forecasting, anomaly detection. Feature-flagged, off by default. All recommendations are advisory, never official decisions.",
  "version": "0.1.0",
  "protocolVersion": "2026-07-28",
  "tier": "Experimental",
  "status": "planned",
  "transport": ["streamable-http"],
  "stateless": true,
  "canonicalResource": "https://tradeops.local/mcp/ai-layer",
  "featureFlags": {
    "FF_RAG": false,
    "FF_FORECAST": false,
    "FF_ANOMALY": false
  },
  "tools": [
    { "name": "rag.search",       "description": "Semantic search over cargo documents.",             "readOnly": true },
    { "name": "forecast.predict", "description": "Cargo volume forecast (Task-backed).",              "readOnly": true, "requiresExtensions": ["io.modelcontextprotocol/tasks"] },
    { "name": "anomaly.detect",   "description": "Compliance risk detection with MRTR confirmation.", "readOnly": true, "mrtr": ["human_confirmation"] }
  ],
  "resources": [
    { "name": "embeddings", "uriTemplate": "ai://embeddings/{docId}", "mimeType": "application/json" }
  ],
  "capabilities": {
    "io.modelcontextprotocol/tasks": true,
    "io.modelcontextprotocol/ui": false,
    "io.modelcontextprotocol/skills": false
  },
  "scopes": [
    "ai.rag.read",
    "ai.forecast.read",
    "ai.anomaly.read"
  ],
  "warnings": [
    "AI outputs are advisory only and must not be treated as official customs decisions.",
    "Requires explicit tenant opt-in via feature flag."
  ],
  "license": "MIT"
}
