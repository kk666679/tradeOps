{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/server.json",
  "name": "io.tradeops.mcp.iot-gateway",
  "title": "IoT Gateway",
  "description": "Edge IoT bridge for weighbridges, ANPR cameras, RFID scanners, and gate controllers.",
  "version": "0.1.0",
  "protocolVersion": "2026-07-28",
  "tier": "Community",
  "status": "planned",
  "transport": ["streamable-http"],
  "stateless": true,
  "canonicalResource": "https://tradeops.local/mcp/iot-gateway",
  "tools": [
    { "name": "device.status", "description": "Query device health.",                    "readOnly": true },
    { "name": "device.read",   "description": "Read current sensor value.",              "readOnly": true },
    { "name": "zone.graph",    "description": "Live zone topology and equipment state.", "readOnly": true }
  ],
  "resources": [
    { "name": "zone-graph", "uriTemplate": "iot://zone/{tenantId}", "ttlSeconds": 15, "mimeType": "application/json" }
  ],
  "capabilities": {
    "io.modelcontextprotocol/tasks": false,
    "io.modelcontextprotocol/ui": true,
    "io.modelcontextprotocol/skills": false
  },
  "subscriptions": {
    "listen": true,
    "kinds": ["toolsListChanged", "resourcesListChanged", "resourceSubscriptions"]
  },
  "scopes": [
    "iot.device.read",
    "iot.zone.read"
  ],
  "license": "MIT"
}
