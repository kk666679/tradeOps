{
  "skill": "custom-agent",
  "version": "1.0.0",
  "description": "Evaluation suite for the custom-agent skill. Cases are stored in reference/golden.jsonl; this file defines how they are scored. This suite has a higher weight on guardrails and refusal than a domain skill, because a mis-defined custom agent propagates to every invocation of that agent.",
  "baseline": {
    "overallPassRate": 1.0,
    "byCategory": {
      "validation": 1.0,
      "forbidden-scope": 1.0,
      "coverage": 1.0,
      "guardrails": 1.0,
      "simulation": 0.9,
      "hygiene": 1.0,
      "refusal": 1.0
    },
    "notes": "Baseline set on 2026-10-09. Any category that falls below its baseline blocks merge. Any category raised above its baseline must be justified in the PR description and the baseline updated in the same commit."
  },
  "scoring": {
    "mode": "exact-match-with-exceptions",
    "rationale": "Agent definitions are security-relevant. A custom agent that passes validation with the wrong scope list will run with the wrong scope list. Fuzzy matching is not appropriate.",
    "fields": {
      "decision": { "comparison": "exact", "required": true, "weight": 4 },
      "reason": { "comparison": "keyword-presence", "weight": 1 },
      "agent.status": { "comparison": "exact", "weight": 2, "whenRequired": "decision == 'accepted'" },
      "agent.scopes": { "comparison": "set-equality", "weight": 3, "whenRequired": "decision == 'accepted'" },
      "validation.unknownSkills": { "comparison": "set-equality", "weight": 2 },
      "validation.missingScopes": { "comparison": "set-equality", "weight": 3 },
      "validation.unusedScopes": { "comparison": "set-equality", "weight": 2 },
      "validation.forbiddenScopes": { "comparison": "set-equality", "weight": 4 },
      "validation.collidingIds": { "comparison": "set-equality", "weight": 2 },
      "validation.reservedNames": { "comparison": "set-equality", "weight": 2 },
      "validation.unknownGuardrailGates": { "comparison": "set-equality", "weight": 2 },
      "simulation.ran": { "comparison": "exact", "weight": 1 },
      "handoffs": { "comparison": "subset", "weight": 1 },
      "audit.rulesApplied": { "comparison": "subset", "weight": 1 }
    },
    "passThreshold": 0.9,
    "criticalFailures": [
      "decision",
      "validation.forbiddenScopes",
      "validation.missingScopes",
      "agent.status"
    ],
    "notes": "The critical-failure list is deliberately strict. A custom agent that slips through with a forbidden scope, a missing scope, or a non-draft status is a security defect, not a scoring miss."
  },
  "categories": [
    { "id": "validation", "description": "Basic definition validity.", "cases": ["CM-001", "CM-002", "CM-008", "CM-016"], "weight": 1.0 },
    { "id": "forbidden-scope", "description": "Attempts to declare a forbidden scope must be rejected without exception.", "cases": ["CM-004", "CM-005", "CM-012", "CM-014"], "weight": 2.5 },
    { "id": "coverage", "description": "Skill-scope coverage and guardrail gate checks.", "cases": ["CM-002", "CM-003", "CM-006", "CM-015"], "weight": 2.0 },
    { "id": "guardrails", "description": "Guardrail firing: mutating scopes, high blast radius, first-in-kind.", "cases": ["CM-006", "CM-007", "CM-010", "CM-017", "CM-019"], "weight": 2.0 },
    { "id": "simulation", "description": "Simulation path.", "cases": ["CM-013", "CM-018", "CM-020"], "weight": 1.0 },
    { "id": "hygiene", "description": "Description hygiene.", "cases": ["CM-009", "CM-011"], "weight": 1.5 },
    { "id": "refusal", "description": "Refusal cases: reserved names, active-id collision, empty scope use.", "cases": ["CM-008", "CM-012", "CM-016", "CM-018"], "weight": 1.5 }
  ],
  "harness": {
    "runner": "server/agents/skills/eval/runner.ts",
    "fixture": "reference/golden.jsonl",
    "stubProcedures": true,
    "stubFile": "server/agents/skills/eval/stubs/custom-agent.stubs.ts",
    "notes": "The runner asserts that no case calls a procedure outside the skill's scope list, and that the simulation path never calls a mutating procedure."
  },
  "reporting": {
    "format": "junit",
    "outputPath": "test-results/custom-agent.xml",
    "includePerCaseDetails": true,
    "includeRuleCoverage": true,
    "ruleCoverageTargets": {
      "reserved-name-check": 1,
      "forbidden-scope-check": 1,
      "skill-existence-check": 1,
      "coverage-check": 1,
      "unused-scope-check": 1,
      "guardrail-gate-check": 1,
      "collision-check": 1,
      "description-hygiene-check": 1,
      "simulation-run": 1,
      "draft-creation": 1,
      "audit-write": 1,
      "duplicate-detection": 1
    }
  }
}
