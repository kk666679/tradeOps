{
  "name": "backend",
  "version": "0.0.1",
  "description": "Backend - Container Freight Station - Warehouse Management System",
  "author": " kmt7977",
  "private": true,
  "license": "Apache 2.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "echo Use: npm run start:backend  OR  npm run start:mcp",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "mcp:launch": "node scripts/mcp-launcher.js",
    "mcp:launch:ts": "tsx scripts/mcp-launcher.ts",
    "start:backend": "node --max-old-space-size=2048 dist/main",
    "start:mcp": "node scripts/mcp-launcher.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-integration.json",
    "test:mcp": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand src/mcp",
    "tradeops": "node ./bin/tradeops.mjs",
    "postinstall": "prisma generate",
    "start:both": "concurrently --names BACKEND,MCP --prefix-colors blue,green \"npm run start:backend\" \"npm run start:mcp\"",
    "start:all": "concurrently --kill-others --names backend,mcp --prefix-colors blue,magenta \"npm:start:backend\" \"npm:start:mcp\"",
    "prestart:all": "bash scripts/prestart-all.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "@tanstack/ai": "^0.68.0",
    "@tanstack/ai-client": "^0.39.0",
    "@tanstack/ai-ollama": "^0.11.14",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/socket.io": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "figlet": "^1.12.0",
    "module-alias": "2.3.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "superjson": "^2.2.6",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/figlet": "^1.7.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "type": "commonjs",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
