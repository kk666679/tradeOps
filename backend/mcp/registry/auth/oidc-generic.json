{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/auth-provider.json",
  "id": "oidc-generic",
  "title": "Generic OIDC",
  "description": "Standards-compliant OIDC with CIMD client registration, S256 PKCE, RFC 8707 resource indicators, and RFC 9207 issuer validation.",
  "type": "oauth2",
  "issuer": "https://idp.tradeops.local",
  "authorizationEndpoint": "https://idp.tradeops.local/oauth2/authorize",
  "tokenEndpoint": "https://idp.tradeops.local/oauth2/token",
  "jwksUri": "https://idp.tradeops.local/.well-known/jwks.json",
  "clientRegistration": "cimd",
  "pkce": "S256",
  "resourceIndicators": true,
  "issuerValidation": "RFC9207"
}
