{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/server.json",
  "name": "io.tradeops.mcp.audit-governance",
  "title": "Audit & Governance",
  "description": "Immutable audit chain, licence registry, and delegation limits. Evidence layer for regulatory compliance.",
  "version": "0.1.0",
  "protocolVersion": "2026-07-28",
  "tier": "Community",
  "status": "planned",
  "transport": ["streamable-http"],
  "stateless": true,
  "canonicalResource": "https://tradeops.local/mcp/audit-governance",
  "tools": [
    { "name": "audit.verify",      "description": "Verify audit chain integrity.", "readOnly": true },
    { "name": "licence.check",     "description": "Check licence validity.",       "readOnly": true },
    { "name": "delegation.limits", "description": "Query delegation limits.",      "readOnly": true }
  ],
  "resources": [
    { "name": "audit-log", "uriTemplate": "audit://log/{tenantId}", "mimeType": "application/json" }
  ],
  "capabilities": {
    "io.modelcontextprotocol/tasks": false,
    "io.modelcontextprotocol/ui": false,
    "io.modelcontextprotocol/skills": false
  },
  "scopes": [
    "governance.audit.read",
    "governance.licence.read",
    "governance.delegation.read"
  ],
  "license": "MIT"
}
