{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/server.json",
  "name": "io.tradeops.mcp.jkdm-customs",
  "title": "JKDM Customs",
  "description": "HS classification, duty and tax calculation, declaration preparation, permit checks, and drawback claims for Malaysian customs.",
  "version": "0.1.0",
  "protocolVersion": "2026-07-28",
  "tier": "Community",
  "status": "planned",
  "transport": ["streamable-http"],
  "stateless": true,
  "canonicalResource": "https://tradeops.local/mcp/jkdm-customs",
  "tools": [
    { "name": "classify.hs",         "description": "HS/AHTN classification with reasoning and citation.", "readOnly": true,  "mrtr": ["low_confidence_confirmation"] },
    { "name": "duty.calculate",      "description": "Duty / SST / excise calculation.",                    "readOnly": true },
    { "name": "declaration.prepare", "description": "Prepare K1/K2/K3/K7/K8/K9 declarations.",             "readOnly": false },
    { "name": "declaration.submit",  "description": "Submit to JKDM (long-running task).",                 "readOnly": false, "highStakes": true, "requiresExtensions": ["io.modelcontextprotocol/tasks"] },
    { "name": "permit.check",        "description": "MAQIS / SIRIM / MITI / MDA permit validation.",       "readOnly": true },
    { "name": "drawback.claim",      "description": "Exemption and drawback claim preparation.",           "readOnly": false, "requiresExtensions": ["io.modelcontextprotocol/tasks"] }
  ],
  "resources": [
    { "name": "tariff",    "uriTemplate": "jkdm://tariff/{code}",       "ttlSeconds": 3600, "mimeType": "application/json" },
    { "name": "fta-rates", "uriTemplate": "jkdm://fta/{scheme}/{code}", "ttlSeconds": 3600, "mimeType": "application/json" }
  ],
  "skills": [
    { "id": "pre-clearance",           "description": "Standard pre-clearance procedure." },
    { "id": "exception-investigation", "description": "Exception investigation and resolution flow." }
  ],
  "capabilities": {
    "io.modelcontextprotocol/tasks": true,
    "io.modelcontextprotocol/ui": true,
    "io.modelcontextprotocol/skills": true
  },
  "scopes": [
    "jkdm.classify.read",
    "jkdm.declaration.write",
    "jkdm.declaration.submit",
    "jkdm.permit.read"
  ],
  "externalDependencies": [
    { "id": "jkdm.ipaduh",  "description": "iPaduh submission gateway.", "auth": "client-certificate" },
    { "id": "jkdm.mystods", "description": "MySToDS document exchange.", "auth": "oauth2" }
  ],
  "license": "MIT"
}
