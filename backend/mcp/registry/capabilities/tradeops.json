{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/capability-catalog.json",
  "id": "tradeops",
  "title": "TradeOps capability catalog",
  "description": "Cross-server capabilities in the TradeOps platform, grouped by domain.",
  "capabilities": [
    {
      "id": "tradeops.gate",
      "title": "Gate operations",
      "servers": ["io.tradeops.mcp.tradeops-core"],
      "tools": ["gate.in", "gate.out"],
      "risk": "medium",
      "requires": ["tradeops.core.write"]
    },
    {
      "id": "tradeops.inventory",
      "title": "Inventory & slot allocation",
      "servers": ["io.tradeops.mcp.tradeops-core"],
      "tools": ["inventory.allocate", "inventory.query"],
      "risk": "low",
      "requires": ["tradeops.core.read", "tradeops.core.write"]
    },
    {
      "id": "tradeops.ledger",
      "title": "Bonded ledger",
      "servers": ["io.tradeops.mcp.tradeops-core"],
      "tools": ["ledger.entry", "ledger.reconcile"],
      "risk": "high",
      "requires": ["tradeops.ledger.write"]
    },
    {
      "id": "tradeops.reconciliation",
      "title": "Bulk reconciliation",
      "servers": ["io.tradeops.mcp.tradeops-core"],
      "tools": ["ledger.reconcile"],
      "risk": "low",
      "extensions": ["io.modelcontextprotocol/tasks"]
    }
  ]
}
