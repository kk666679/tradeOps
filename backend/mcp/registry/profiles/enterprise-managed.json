{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/profile.json",
  "profileId": "enterprise-managed",
  "title": "Enterprise-managed authorization",
  "description": "Agent identities issued by the tenant IdP (Entra ID / Okta). Per-tenant resource indicators, delegated authority, and mandatory governance gateway.",
  "transport": "streamable-http",
  "protocolVersion": "2026-07-28",
  "auth": {
    "provider": "entra-id",
    "clientRegistration": "cimd",
    "pkce": "S256",
    "resourceIndicators": true,
    "enterpriseManaged": {
      "scim": true,
      "groupToScopeMapping": true
    }
  },
  "tenancy": {
    "models": ["pool", "silo", "cellular"],
    "perTenantKeys": true,
    "residency": ["my-west", "my-central"]
  },
  "servers": [
    { "name": "io.tradeops.mcp.tradeops-core",    "required": true  },
    { "name": "io.tradeops.mcp.jkdm-customs",     "required": true  },
    { "name": "io.tradeops.mcp.trade-compliance", "required": true  },
    { "name": "io.tradeops.mcp.iot-gateway",      "required": false },
    { "name": "io.tradeops.mcp.audit-governance", "required": true  }
  ],
  "extensions": {
    "io.modelcontextprotocol/tasks":  { "enabled": true },
    "io.modelcontextprotocol/ui":     { "enabled": true },
    "io.modelcontextprotocol/skills": { "enabled": true }
  },
  "governance": {
    "auditChain": "external",
    "policyEngine": "gateway",
    "policyBundle": "regulated-enterprise",
    "otel": { "enabled": true, "exporter": "otlp" },
    "capabilityDriftMonitoring": true,
    "requireApprovalFor": ["declaration.submit", "ledger.move", "gate.bondedOut"]
  },
  "routing": {
    "headerMirroring": true,
    "requireResourceHeader": true
  },
  "subscriptions": {
    "listen": true,
    "kinds": ["toolsListChanged", "resourcesListChanged", "resourceSubscriptions"]
  }
}
