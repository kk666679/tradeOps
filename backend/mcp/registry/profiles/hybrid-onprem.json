{
  "$schema": "https://modelcontextprotocol.io/schemas/2026-07-28/profile.json",
  "profileId": "hybrid-onprem",
  "title": "Hybrid on-premises",
  "description": "Some servers run on-premises (IoT gateway, audit chain) while the web tier runs in the cloud. IoT gateway communicates over a mutually authenticated tunnel.",
  "transport": "streamable-http",
  "protocolVersion": "2026-07-28",
  "auth": {
    "provider": "oidc-generic",
    "clientRegistration": "cimd",
    "pkce": "S256",
    "resourceIndicators": true,
    "tunnel": {
      "type": "mtls",
      "onpremGateways": ["iot-gateway", "audit-governance"]
    }
  },
  "servers": [
    { "name": "io.tradeops.mcp.tradeops-core",    "required": true, "location": "cloud"   },
    { "name": "io.tradeops.mcp.jkdm-customs",     "required": true, "location": "cloud"   },
    { "name": "io.tradeops.mcp.trade-compliance", "required": true, "location": "cloud"   },
    { "name": "io.tradeops.mcp.iot-gateway",      "required": true, "location": "on-prem" },
    { "name": "io.tradeops.mcp.audit-governance", "required": true, "location": "on-prem" }
  ],
  "extensions": {
    "io.modelcontextprotocol/tasks":  { "enabled": true },
    "io.modelcontextprotocol/ui":     { "enabled": true },
    "io.modelcontextprotocol/skills": { "enabled": true }
  },
  "governance": {
    "auditChain": "external-onprem",
    "policyEngine": "gateway",
    "policyBundle": "tradeops-default",
    "otel": { "enabled": true, "exporter": "otlp" }
  },
  "routing": {
    "headerMirroring": true,
    "requireResourceHeader": true
  }
}
