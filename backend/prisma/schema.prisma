enum ApprovalKind {
  PURCHASE
  DECLARATION
  PERMIT
  GATE_RELEASE
  BONDED_WRITE_OFF
  EXEMPTION_CLAIM
  SUBCONTRACT
}

enum ApprovalStatus {
