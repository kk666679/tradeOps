// =============================================================================
// DIGITAL TWIN · SCENARIOS · RUNS · NODES · EDGES · METRICS
// =============================================================================

enum TwinRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model TwinScenario {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  inputs       Json
  assertions   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs         TwinRun[]

  @@index([tenantId])
}

model TwinRun {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scenarioId   String
  scenario     TwinScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  status       TwinRunStatus @default(QUEUED)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  horizonDays  Int           @default(30)
  result       Json?
  error        String?

  metrics      TwinMetric[]

  @@index([tenantId, status])
}

model TwinNode {
  id           String   @id @default(cuid())
  zoneId       String
  zone         Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  label        String
  kind         String   // zone, gate, dock, slot, agent, task
  x            Float?
  y            Float?
  metadata     Json?

  edgesFrom    TwinEdge[] @relation("TwinFrom")
  edgesTo      TwinEdge[] @relation("TwinTo")

  @@index([zoneId])
}

model TwinEdge {
  id           String   @id @default(cuid())
  fromId       String
  from         TwinNode @relation("TwinFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId         String
  to           TwinNode @relation("TwinTo", fields: [toId], references: [id], onDelete: Cascade)
  kind         String   // flow, handoff, movement
  weight       Float?
  metadata     Json?

  @@index([fromId])
  @@index([toId])
}

model TwinMetric {
  id           String   @id @default(cuid())
  runId        String
  run          TwinRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  name         String
  value        Float
  unit         String?
  at           DateTime @default(now())

  @@index([runId, name])
}

// =============================================================================
// INTEGRATIONS · GATEWAYS · EDI · WEBHOOKS · SYNC JOBS
// =============================================================================

enum IntegrationKind {
  CUSTOMS
  FIZ_FCZ
  AGENT_MESH
  EDI
  ERP
  TMS
  WMS
  WEBHOOK
  OAUTH
}

enum IntegrationStatus {
  ACTIVE
  PAUSED
  ERROR
  DISABLED
}

model Integration {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         IntegrationKind
  name         String
  endpoint     String?
  status       IntegrationStatus @default(ACTIVE)
  config       Json?
  secretRef    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  logs         IntegrationLog[]

  @@index([tenantId, kind, status])
}

model IntegrationLog {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  direction     String      // IN | OUT
  status        Int
  latencyMs     Int?
  request       Json?
  response      Json?
  error         String?
  at            DateTime    @default(now())

  @@index([tenantId, at])
  @@index([integrationId, at])
}

model Webhook {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url          String
  events       String[]
  secret       String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliveries   WebhookDelivery[]

  @@index([tenantId, active])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  status       Int
  attempt      Int      @default(1)
  request      Json
  response     Json?
  error        String?
  at           DateTime @default(now())

  @@index([webhookId, at])
}

model EdiMapping {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  version      String
  spec         String   // EDIFACT, X12, ASYCUDA, custom
  inbound      Json?
  outbound     Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, name, version])
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model SyncJob {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         String
  target       String
  status       SyncJobStatus @default(QUEUED)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  cursor       String?
  processed    Int           @default(0)
  error        String?
  metadata     Json?

  @@index([tenantId, status])
}

// =============================================================================
// CUSTOM AGENTS · REGISTRY · RUNS · MEMORY · APPROVALS · EVALS · AUDIT
// =============================================================================

enum AgentStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

enum AgentKind {
  DOCUMENT
  OPS
  INVENTORY
  FORECAST
  RISK
  CUSTOMS
  ZONE
  PLANNER
  CRITIC
  ROUTER
  CUSTOM
}

model Agent {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  kind         AgentKind
  status       AgentStatus @default(DRAFT)
  description  String?
  icon         String?
  color        String?
  scopes       String[]
  guardrailIds String[]
  config       Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  versions     AgentVersion[]
  runs         AgentRun[]
  memories     AgentMemory[]
  policies     AgentPolicy[]
  approvals    AgentApproval[]
  escalations  AgentEscalation[]
  evals        AgentEval[]

  @@unique([tenantId, slug])
  @@index([tenantId, kind, status])
}

model AgentVersion {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version      String
  definition   Json
  changelog    String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([agentId, version])
}

model AgentSkill {
  id           String   @id @default(cuid())
  agentId      String?
  skillId      String
  name         String
  domain       String
  version      String   @default("1.0.0")
  definition   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([agentId, skillId])
  @@index([domain])
}

model AgentTool {
  id           String   @id @default(cuid())
  agentId      String?
  toolId       String
  kind         String   // http, sql, customs, zone, doc, llm, vector
  config       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agentId])
}

model AgentGuardrail {
  id           String   @id @default(cuid())
  guardrailId  String   @unique
  scope        String   // global, tenant, jurisdiction, spend, data-access
  mode         String   @default("fail-closed")
  definition   Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  AWAITING_APPROVAL
  CANCELLED
}

model AgentRun {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parentRunId  String?
  parentRun    AgentRun?      @relation("RunTree", fields: [parentRunId], references: [id], onDelete: SetNull)
  children     AgentRun[]     @relation("RunTree")
  status       AgentRunStatus @default(QUEUED)
  trigger      String?        // user, schedule, webhook, handoff
  input        Json?
  output       Json?
  error        String?
  costUsd      Float          @default(0)
  tokensIn     Int            @default(0)
  tokensOut    Int            @default(0)
  latencyMs    Int?
  startedAt    DateTime       @default(now())
  endedAt      DateTime?

  steps        AgentStep[]
  handoffsOut  AgentHandoff[] @relation("HandoffFrom")
  handoffsIn   AgentHandoff[] @relation("HandoffTo")
  approvals    AgentApproval[]

  @@index([tenantId, status])
  @@index([tenantId, agentId, startedAt])
}

enum AgentStepKind {
  THINK
  TOOL
  HANDOFF
  APPROVE
  MEMORY_READ
  MEMORY_WRITE
  MODEL
  ERROR
}

model AgentStep {
  id           String         @id @default(cuid())
  runId        String
  run          AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind         AgentStepKind
  seq          Int
  payload      Json?
  costUsd      Float          @default(0)
  tokensIn     Int            @default(0)
  tokensOut    Int            @default(0)
  latencyMs    Int?
  at           DateTime       @default(now())

  @@index([runId, seq])
}

model AgentHandoff {
  id           String   @id @default(cuid())
  fromRunId    String
  fromRun      AgentRun @relation("HandoffFrom", fields: [fromRunId], references: [id], onDelete: Cascade)
  toRunId      String?
  toRun        AgentRun? @relation("HandoffTo", fields: [toRunId], references: [id], onDelete: SetNull)
  toAgentId    String
  reason       String?
  status       String   @default("pending")
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  at           DateTime @default(now())

  @@index([fromRunId])
}

model AgentMemory {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runId        String?
  kind         String   // short-term, long-term, episodic
  key          String
  value        Json
  ttlSec       Int?
  createdAt    DateTime @default(now())
  expiresAt    DateTime?

  @@index([tenantId, agentId, kind])
  @@index([expiresAt])
}

enum ApprovalDecision {
  PENDING
  APPROVE
  REJECT
  ESCALATE
}

model AgentApproval {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runId        String
  run          AgentRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  reason       String
  severity     FindingSeverity  @default(MEDIUM)
  amountUsd    Float?
  decision     ApprovalDecision @default(PENDING)
  approverId   String?
  approver     User?            @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  deadline     DateTime?
  metadata     Json?
  createdAt    DateTime         @default(now())

  @@index([tenantId, decision])
  @@index([agentId])
  @@index([runId])
}

model AgentEscalation {
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  id           String          @id @default(cuid())
  tenantId     String
  agentId      String
  agent        Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runId        String?
  reason       String
  severity     FindingSeverity @default(MEDIUM)
  acknowledged Boolean         @default(false)
  acknowledgedAt DateTime?
  metadata     Json?
  createdAt    DateTime        @default(now())

  @@index([tenantId, acknowledged])
}

model AgentPolicy {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  scope        String
  name         String
  rules        Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, active])
}

enum EvalStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AgentEval {
  id           String     @id @default(cuid())
  agentId      String
  agent        Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  suite        String
  status       EvalStatus @default(QUEUED)
  passRate     Float?
  precision    Float?
  recall       Float?
  costUsd      Float?
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  report       Json?

  cases        AgentEvalCase[]

  @@index([agentId, suite])
}

model AgentEvalCase {
  id           String    @id @default(cuid())
  evalId       String
  eval         AgentEval @relation(fields: [evalId], references: [id], onDelete: Cascade)
  input        Json
  expected     Json?
  actual       Json?
  passed       Boolean?
  score        Float?
  latencyMs    Int?
  createdAt    DateTime  @default(now())

  @@index([evalId])
}

model AgentAuditEntry {
  id           String   @id @default(cuid())
  tenantId     String
  runId        String?
  agentId      String?
  actor        String   // agent | human | system
  action       String
  target       String?
  payload      Json?
  evidence     Json?
  prevHash     String?
  hash         String
  at           DateTime @default(now())

  @@index([tenantId, at])
  @@index([runId])
}

// =============================================================================
// .autoclaw RUNTIME · WORKFLOWS · GUARDRAIL HITS · SNAPSHOTS
// =============================================================================

model AutoclawSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version      String
  configYaml   String
  agentsYaml   String?
  guardrailsYaml String?
  workflowsYaml  String?
  promptHash   String?
  createdAt    DateTime @default(now())

  @@index([tenantId, version])
}

model Workflow {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowId   String
  name         String
  version      String   @default("1.0.0")
  definition   Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs         WorkflowRun[]

  @@unique([tenantId, workflowId, version])
}

enum WorkflowRunStatus {
  QUEUED
  RUNNING
  CANCELLING
  SUCCEEDED
  FAILED
  AWAITING_APPROVAL
  CANCELLED
}

model WorkflowRun {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowId      String
  workflow        Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status          WorkflowRunStatus @default(QUEUED)
  input           Json?
  output          Json?
  error           String?
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  steps           Json?
  // Seed-loop fields
  seedDatasetId   String?
  seedDataset     SeedDataset?      @relation(fields: [seedDatasetId], references: [id], onDelete: SetNull)
  loopConfig      Json?             // { strategy, batchSize, continueOnError, maxRetries, backoffMs }
  idempotencyKey  String?           @unique
  totalIterations Int               @default(0)
  doneIterations  Int               @default(0)
  failedIterations Int              @default(0)

  iterations      LoopIteration[]
  logs            ExecutionLog[]

  @@index([tenantId, status])
  @@index([tenantId, seedDatasetId])
}

// =============================================================================
// SEED-DRIVEN LOOP EXECUTION
// =============================================================================

model SeedDataset {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  schema      Json?         // JSON Schema for record validation
  recordCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  records     SeedRecord[]
  runs        WorkflowRun[]

  @@index([tenantId])
}

enum SeedRecordStatus {
  VALID
  INVALID
  PENDING
}

model SeedRecord {
  id          String           @id @default(cuid())
  datasetId   String
  dataset     SeedDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  recordId    String           // stable, user-visible ID (e.g. row number or external key)
  payload     Json
  status      SeedRecordStatus @default(PENDING)
  validationErrors Json?       // array of { field, message }
  createdAt   DateTime         @default(now())

  iterations  LoopIteration[]

  @@unique([datasetId, recordId])
  @@index([datasetId, status])
}

enum IterationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  RETRYING
}

model LoopIteration {
  id          String          @id @default(cuid())
  runId       String
  run         WorkflowRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  recordId    String
  record      SeedRecord      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  status      IterationStatus @default(PENDING)
  attempt     Int             @default(1)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  endedAt     DateTime?
  durationMs  Int?

  logs        ExecutionLog[]

  @@unique([runId, recordId])
  @@index([runId, status])
  @@index([recordId])
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model ExecutionLog {
  id            String      @id @default(cuid())
  tenantId      String
  runId         String
  run           WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  iterationId   String?
  iteration     LoopIteration? @relation(fields: [iterationId], references: [id], onDelete: SetNull)
  level         LogLevel    @default(INFO)
  message       String
  nodeId        String?
  payload       Json?
  at            DateTime    @default(now())

  @@index([runId, at])
  @@index([iterationId, at])
  @@index([tenantId, level, at])
}

model GuardrailHit {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardrailId  String
  scope        String
  severity     FindingSeverity @default(MEDIUM)
  action       String          // block, warn, escalate, redact
  subject      String?
  payload      Json?
  at           DateTime        @default(now())

  @@index([tenantId, at])
  @@index([tenantId, guardrailId])
}

// =============================================================================
// RULE PACKS
// =============================================================================

model RulePack {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  packId       String
  jurisdiction String
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions     RulePackVersion[]

  @@unique([tenantId, packId])
}

model RulePackVersion {
  id           String   @id @default(cuid())
  rulePackId   String
  rulePack     RulePack @relation(fields: [rulePackId], references: [id], onDelete: Cascade)
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  version      String
  definition   Json
  publishedAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([rulePackId, version])
}

// =============================================================================
// AUDIT LOG · EVENT BUS · JOBS · HEALTH
// =============================================================================

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor        String   @default("human")  // human, agent, system
  action       String
  target       String?
  meta         Json?
  prevHash     String?
  hash         String
  at           DateTime @default(now())

  @@index([tenantId, at])
  @@index([tenantId, action])
  @@index([userId])
}

model DomainEvent {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  topic        String
  payload      Json
  delivered    Boolean  @default(false)
  retries      Int      @default(0)
  at           DateTime @default(now())
  processedAt  DateTime?

  @@index([tenantId, topic, delivered])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Job {
  id           String    @id @default(cuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queue        String
  name         String
  status       JobStatus @default(QUEUED)
  payload      Json?
  result       Json?
  error        String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  at           DateTime  @default(now())

  @@index([queue, status])
  @@index([tenantId, status])
}

model ServiceHealth {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service      String
  status       String
  latencyMs    Int?
  detail       Json?
  at           DateTime @default(now())

  @@index([service, at])
}

