// =============================================================================
// CFS WMS · FIZ / FCZ · Trade OPS · Custom Agents — Full Prisma Schema
// =============================================================================
// Conventions:
//   - All tenant-scoped entities carry `tenantId` and are indexed on
//     `[tenantId, ...]` so tenant isolation stays a single index walk.
//   - IDs are `cuid()` for stable, URL-safe, collision-resistant keys.
//   - Free-form data uses `Json` (metadata, payload, config, evidence).
//   - Statuses are Prisma enums so the DB rejects typos at write time.
//   - Audit entries are hash-chained: `prevHash` → `hash`.
//   - Time fields use `DateTime` with `@default(now())` or `@updatedAt`.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, uuid_ossp(map: "uuid-ossp"), vector]
}

// =============================================================================
// MULTI-TENANCY
// =============================================================================

enum TenantPlan {
  TRIAL
  STARTER
  GROWTH
  OPERATOR
  ENTERPRISE
}

enum TenantIsolation {
  POOL      // shared DB, tenantId-scoped
  SILO      // dedicated schema
  CELLULAR  // dedicated data plane
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Tenant {
  id         String          @id @default(cuid())
  name       String
  slug       String          @unique
  plan       TenantPlan      @default(STARTER)
  isolation  TenantIsolation @default(POOL)
  status     TenantStatus    @default(ACTIVE)
  region     String          @default("ap-southeast")
  locale     String          @default("en-MY")
  currency   String          @default("MYR")
  timezone   String          @default("Asia/Kuala_Lumpur")

  // config + limits
  config     Json?           // feature flags, quotas, defaults
  quotas     Json?           // { dailyUsd, monthlyUsd, maxZones, maxAgents }

  // billing
  stripeCustomerId String?
  billingEmail     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  roles              Role[]
  apiKeys            ApiKey[]
  sessions           Session[]
  invitations        Invitation[]
  agents             Agent[]
  agentRuns          AgentRun[]
  agentMemories      AgentMemory[]
  agentPolicies      AgentPolicy[]
  agentApprovals     AgentApproval[]
  agentEscalations   AgentEscalation[]
  auditLogs          AuditLog[]
  seedDatasets       SeedDataset[]
  zones              Zone[]
  zoneTenants        ZoneTenant[]
  cargo              Cargo[]
  declarations       Declaration[]
  permits            Permit[]
  clearanceRecords   ClearanceRecord[]
  complianceFindings ComplianceFinding[]
  permitsRegistry    PermitDefinition[]
  tradeDocuments     TradeDocument[]
  drawbackClaims     DrawbackClaim[]
  exemptions         ExemptionScheme[]
  exemptionClaims    ExemptionClaim[]
  bondedLedger       BondedLedger[]
  bondedStock        BondedStock[]
  hsCodes            HsCode[]
  hsCodeAliases      HsCodeAlias[]
  hsCodeRulings      HsCodeRuling[]
  hsCodeChangeLogs   HsCodeChangeLog[]
  movements          Movement[]
  gatePasses         GatePass[]
  gateEvents         GateEvent[]
  slots              Slot[]
  slotAllocations    SlotAllocation[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  cycleCounts        CycleCount[]
  holds              Hold[]
  inboundReceipts    InboundReceipt[]
  outboundOrders     OutboundOrder[]
  purchaseOrders     PurchaseOrder[]
  manufacturingOrders ManufacturingOrder[]
  tradingOrders      TradingOrder[]
  transhipmentOrders TranshipmentOrder[]
  fulfilmentOrders   FulfilmentOrder[]
  orderApprovals     OrderApproval[]
  twinScenarios      TwinScenario[]
  twinRuns           TwinRun[]
  integrations       Integration[]
  integrationLogs    IntegrationLog[]
  webhooks           Webhook[]
  webhookDeliveries  WebhookDelivery[]
  ediMappings        EdiMapping[]
  syncJobs           SyncJob[]
  domainsEvents      DomainEvent[]
  jobs               Job[]
  rulePacks          RulePack[]
  rulePackVersions   RulePackVersion[]
  guardrailHits      GuardrailHit[]
  workflows          Workflow[]
  workflowRuns       WorkflowRun[]
  autoclawSnapshots  AutoclawSnapshot[]
  serviceHealth      ServiceHealth[]
  jkdmOperations     JkdmOperation[]
  jkdmManualResponses JkdmManualResponse[]

  @@index([slug])
  @@index([status, plan])
}

// =============================================================================
// IDENTITY · USERS · SESSIONS · PASSKEYS · RBAC
// =============================================================================

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DELETED
}

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  OPS_MANAGER
  WAREHOUSE_STAFF
  CUSTOMER
  AGENT
  AUDITOR
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String     @unique
  emailVerified DateTime?
  password     String
  name         String?
  avatarUrl    String?
  phone        String?
  locale       String     @default("en-MY")
  timezone     String     @default("Asia/Kuala_Lumpur")

  role         GlobalRole @default(WAREHOUSE_STAFF)
  status       UserStatus @default(ACTIVE)

  mfaEnabled   Boolean    @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  lastLoginIp  String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles         UserRole[]
  sessions      Session[]
  passkeys      Passkey[]
  apiKeys       ApiKey[]
  sentInvites   Invitation[]  @relation("Inviter")
  auditLogs     AuditLog[]
  approvals     AgentApproval[] @relation("Approver")
  orderApprovals OrderApproval[] @relation("Approver")
  wmsMovements  InventoryMovement[] @relation("Actor")
  emailVerifications EmailVerification[]

  @@index([tenantId, status])
  @@index([tenantId, role])
}

model Session {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Passkey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  transports   String[]
  aaguid       String?
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  label      String
  prefix     String    @unique
  hashedKey  String    @unique
  scopes     String[]
  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  lastUsedIp String?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([prefix])
}

model Invitation {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  role       GlobalRole @default(WAREHOUSE_STAFF)
  token      String    @unique
  invitedById String
  invitedBy  User      @relation("Inviter", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([tenantId, email])
  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// ---- RBAC (custom roles + permissions per tenant) ----

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  system      Boolean  @default(false)  // system roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  action      String   @unique  // e.g. "declaration:file"
  description String?
  domain      String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([domain])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  since  DateTime @default(now())

  @@id([userId, roleId])
}

// =============================================================================
// ZONES · FIZ · FCZ · BONDED
// =============================================================================

enum ZoneType {
  FIZ      // Free Industrial Zone
  FCZ      // Free Commercial Zone
  BONDED   // Bonded warehouse
  FTZ      // Free Trade Zone
  SEZ      // Special Economic Zone
}

enum ZoneStatus {
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
}

model Zone {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  type        ZoneType
  status      ZoneStatus  @default(ACTIVE)
  country     String      @default("MY")
  region      String?
  address     String?
  latitude    Float?
  longitude   Float?
  timezone    String      @default("Asia/Kuala_Lumpur")
  operatingHours Json?
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zoneTenants    ZoneTenant[]
  cargo          Cargo[]
  slots          Slot[]
  inboundReceipts InboundReceipt[]
  outboundOrders  OutboundOrder[]
  bondedStock     BondedStock[]
  bondedLedger    BondedLedger[]
  movementsFrom   Movement[]  @relation("MovementFrom")
  movementsTo     Movement[]  @relation("MovementTo")
  gatePasses      GatePass[]
  gateEvents      GateEvent[]
  exemptions      ExemptionScheme[]
  twinNodes       TwinNode[]

  @@unique([tenantId, code])
  @@index([tenantId, type, status])
}

model ZoneTenant {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId       String
  zone         Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  legalName    String
  registrationNo String?
  leaseFrom    DateTime?
  leaseTo      DateTime?
  areaSqm      Float?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  fizOperators   FizOperator[]
  tradingHouses  TradingHouse[]

  @@index([tenantId, zoneId])
}

// =============================================================================
// CARGO · CARGO LINES · HAZMAT
// =============================================================================

enum CargoStatus {
  DRAFT
  RECEIVED
  IN_STORAGE
  PICKING
  PACKING
  DISPATCHED
  HELD
  RETURNED
  DISPOSED
}

enum CargoKind {
  GENERAL
  BULK
  DRY_BULK
  LIQUID_BULK
  BREAK_BULK
  CONTAINERIZED
  HAZMAT
}

model Cargo {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId      String?
  zone        Zone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  ref         String
  kind        CargoKind   @default(GENERAL)
  status      CargoStatus @default(RECEIVED)
  description String?

  containerNo String?
  sealNo      String?
  blNo        String?
  vessel      String?
  voyage      String?
  portOfLoading String?
  portOfDischarge String?
  incoterms   String?

  weightKg    Float?
  volumeM3    Float?
  packages    Int?
  uom         String?

  hazmat      Boolean     @default(false)
  customerRef String?
  metadata    Json?
  tags        String[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines            CargoLine[]
  hazmatProfile    HazmatProfile?
  declarations     Declaration[]
  inboundReceipts  InboundReceipt[]
  outboundOrders   OutboundOrder[]
  movements        Movement[]
  gatePasses       GatePass[]
  tradeDocuments   TradeDocument[]

  @@unique([tenantId, ref])
  @@index([tenantId, status])
  @@index([tenantId, zoneId, status])
  @@index([tenantId, hazmat])
}

model CargoLine {
  id          String  @id @default(cuid())
  cargoId     String
  cargo       Cargo   @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  lineNo      Int
  hsCode      String?
  description String
  qty         Float
  uom         String
  unitValue   Float?
  currency    String  @default("MYR")
  origin      String?
  metadata    Json?

  @@index([cargoId])
}

model HazmatProfile {
  id           String   @id @default(cuid())
  cargoId      String   @unique
  cargo        Cargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  unClass      String?
  unNumber     String?
  packingGroup String?
  properName   String?
  segregation  String?
  notes        String?
  createdAt    DateTime @default(now())
}

// =============================================================================
// TRADE OPS · DECLARATIONS · HS · DUTY · PERMITS · CLEARANCE · COMPLIANCE
// =============================================================================

enum DeclarationStatus {
  DRAFT
  SUBMITTED
  ASSESSED
  RELEASED
  CANCELLED
  AMENDED
  REJECTED
}

enum ChannelType {
  GREEN
  YELLOW
  RED
}

model Declaration {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ref          String
  status       DeclarationStatus  @default(DRAFT)
  zoneId       String?
  cargoId      String?
  cargo        Cargo?             @relation(fields: [cargoId], references: [id], onDelete: SetNull)

  declarationType String?         // IM, EX, TR, etc.
  regime       String?            // FIZ, FCZ, BONDED, FTZ
  channel      ChannelType?

  declarantName String?
  declarantId   String?

  consigneeName String?
  consigneeId   String?
  notifyName    String?
  notifyId      String?

  origin       String?
  destination  String?
  currency     String  @default("MYR")
  totalValue   Float   @default(0)
  totalDuty    Float   @default(0)
  totalTax     Float   @default(0)

  submittedAt  DateTime?
  assessedAt   DateTime?
  releasedAt   DateTime?
  cancelledAt  DateTime?

  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines                DeclarationLine[]
  dutyCalcs            DutyCalculation[]
  clearance            ClearanceRecord?
  findings             ComplianceFinding[]
  originDetermination  OriginDetermination?
  valuation            Valuation?
  documents            TradeDocument[]
  drawbackClaims       DrawbackClaim[]
  jkdmOperations       JkdmOperation[]
  jkdmManualResponses  JkdmManualResponse[]

  @@unique([tenantId, ref])
  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([tenantId, submittedAt])
}

model DeclarationLine {
  id             String      @id @default(cuid())
  declarationId  String
  declaration    Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  lineNo         Int
  hsCode         String
  description    String
  qty            Float
  uom            String
  unitValue      Float
  value          Float
  currency       String      @default("MYR")
  origin         String?
  netWeightKg    Float?
  grossWeightKg  Float?
  dutyRate       Float?
  taxRate        Float?
  metadata       Json?

  @@index([declarationId])
  @@index([hsCode])
}

enum HsCodeKind {
  PRODUCT
  MATERIAL
  EQUIPMENT
  PART
  RAW
  CONSUMABLE
}

enum HsCodeStatus {
  ACTIVE
  SUPERSEDED
  OBSOLETE
  PROVISIONAL
}

model HsCode {
  id           String        @id @default(cuid())
  tenantId     String?
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  code         String
  parentId     String?
  parent       HsCode?       @relation("HsParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     HsCode[]      @relation("HsParent")
  parentCode   String?
  description  String
  chapter      String
  heading      String
  subheading   String?
  kind         HsCodeKind    @default(PRODUCT)
  status       HsCodeStatus  @default(ACTIVE)
  dutyRate     Float         @default(0)
  salesTaxRate Float         @default(0)
  exciseRate   Float         @default(0)
  stampDutyRate Float        @default(0)
  importQuota  Boolean       @default(false)
  controlled   Boolean       @default(false)
  restricted   Boolean       @default(false)
  hazardous    Boolean       @default(false)
  uom          String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  aliases        HsCodeAlias[]
  rulings        HsCodeRuling[]
  changeLogs     HsCodeChangeLog[]

  @@unique([tenantId, code])
  @@index([tenantId, code])
  @@index([tenantId, status])
  @@index([chapter])
  @@index([heading])
  @@index([parentCode])
}

model HsCodeAlias {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  hsCodeId   String
  hsCode     HsCode    @relation(fields: [hsCodeId], references: [id], onDelete: Cascade)
  code       String
  authority  String?  // e.g. MITI, Customs, WCO
  note       String?
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId, code])
  @@index([hsCodeId])
}

enum RulingKind {
  BINDING
  ADVANCE
  CLASSIFICATION
  VALUATION
  ORIGIN
}

enum RulingStatus {
  ACTIVE
  EXPIRED
  REVOKED
  SUPERSEDED
}

model HsCodeRuling {
  id           String        @id @default(cuid())
  tenantId     String?
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  hsCodeId     String
  hsCode       HsCode        @relation(fields: [hsCodeId], references: [id], onDelete: Cascade)
  rulingRef    String
  kind         RulingKind
  authority    String
  issuedAt     DateTime
  validTo      DateTime?
  status       RulingStatus @default(ACTIVE)
  summary      String?
  rationale    String?
  evidence     Json?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, authority])
  @@index([hsCodeId])
  @@unique([tenantId, rulingRef])
}

enum HsChangeKind {
  AMENDMENT
  REVISION
  SUPERSESSION
  RECLASSIFICATION
}

model HsCodeChangeLog {
  id            String        @id @default(cuid())
  tenantId      String?
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  hsCodeId      String
  hsCode        HsCode        @relation(fields: [hsCodeId], references: [id], onDelete: Cascade)
  previousCode  String?
  newCode       String
  kind          HsChangeKind
  effectiveFrom DateTime
  announcedAt   DateTime?
  source        String?       // WCO HS2022, MITI P.U., Customs circular
  reason        String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  @@index([tenantId, effectiveFrom])
  @@index([hsCodeId])
  @@index([newCode])
}

model DutyCalculation {
  id             String       @id @default(cuid())
  declarationId  String
  declaration    Declaration  @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  method         String       // transaction, CIF, FOB, fallback
  assessableValue Float
  currency       String       @default("MYR")
  duty           Float        @default(0)
  salesTax       Float        @default(0)
  excise         Float        @default(0)
  total          Float        @default(0)
  breakdown      Json?
  createdAt      DateTime     @default(now())

  @@index([declarationId])
}

enum PermitStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

model PermitDefinition {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  authority   String   // MITI, MIDA, Customs, MAQIS, SIRIM, etc.
  description String?
  leadTimeDays Int?
  metadata    Json?
  createdAt   DateTime @default(now())

  permits     Permit[]

  @@unique([tenantId, code])
}

model Permit {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definitionId  String?
  definition    PermitDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  ref           String
  status        PermitStatus   @default(DRAFT)
  authority     String
  validFrom     DateTime?
  validTo       DateTime?
  issuedAt      DateTime?
  rejectedAt    DateTime?
  attachmentUrl String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([tenantId, ref])
  @@index([tenantId, status])
  @@index([tenantId, validTo])
}

model ClearanceRecord {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  declarationId String        @unique
  declaration   Declaration   @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  channel       ChannelType
  releasedAt    DateTime?
  detentionFrom DateTime?
  detentionTo   DateTime?
  inspectionAt  DateTime?
  officer       String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId, channel])
  @@index([tenantId, releasedAt])
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ComplianceFinding {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  declarationId  String?
  declaration    Declaration?    @relation(fields: [declarationId], references: [id], onDelete: SetNull)
  severity       FindingSeverity
  kind           String          // hs, valuation, origin, screening, bottleneck
  message        String
  evidence       Json?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime        @default(now())

  @@index([tenantId, severity])
  @@index([tenantId, kind])
}

model OriginDetermination {
  id             String      @id @default(cuid())
  declarationId  String      @unique
  declaration    Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  scheme         String      // ATIGA, RCEP, FTA, unilateral
  originCountry  String
  ruleApplied    String?
  localContentPct Float?
  rationale      String?
  evidence       Json?
  createdAt      DateTime    @default(now())
}

model Valuation {
  id             String      @id @default(cuid())
  declarationId  String      @unique
  declaration    Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  method         String
  currency       String      @default("MYR")
  invoiceValue   Float?
  freight        Float?
