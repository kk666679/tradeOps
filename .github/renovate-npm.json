{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":semanticCommitScope(deps)", "schedule:weekly"],
  "enabled": true,
  "ignorePresets": ["workarounds:nodeEvolvingNode"],
  "python": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "enabled": true,
      "pinDigests": true,
      "separateMajorMinor": true,
      "separateMinorPatch": false,
      "labels": ["dependencies", "github-actions"],
      "reviewers": ["kmt7977"],
      "schedule": ["before 5am on Monday"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "enabled": true,
      "labels": ["dependencies", "patch"],
      "schedule": ["before 5am on Monday"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor"],
      "enabled": true,
      "labels": ["dependencies", "minor"],
      "reviewers": ["kmt7977"],
      "schedule": ["before 5am on Monday"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "labels": ["dependencies", "major"],
      "reviewers": ["kmt7977"],
      "schedule": ["before 5am on Monday"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "enabled": true,
      "labels": ["dependencies", "dev"],
      "schedule": ["before 5am on Monday"]
    },
    {
      "matchPackageNames": ["next", "@nestjs/*", "@prisma/client", "prisma", "typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "labels": ["dependencies", "major", "high-risk"],
      "reviewers": ["kmt7977"],
      "schedule": ["before 5am on Monday"]
    },
    {
      "matchPackageNames": ["@prisma/client", "prisma"],
      "matchUpdateTypes": ["minor"],
      "enabled": true,
      "labels": ["dependencies", "prisma", "high-risk"],
      "reviewers": ["kmt7977"],
      "schedule": ["before 5am on Monday"]
    }
  ],
  "hostRules": [
    {
      "hostName": "github.com",
      "token": "${{ secrets.GITHUB_TOKEN }}",
      "enabled": true
    }
  ],
  "ignoreDeps": [
    "node"
  ]
}