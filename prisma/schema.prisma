// prisma/schema.prisma
//
// Base schema. Extend with your domain models as you build out routers.
// After editing:
//   npx prisma generate
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Auth
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  verifications VerificationToken[]

  @@index([tenantId])
  @@index([role])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPS_MANAGER
  WAREHOUSE_STAFF
  CUSTOMER
  AGENT
  AUDITOR
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
}

// ============================================================
// Tenancy
// ============================================================

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  plan      TenantPlan   @default(STARTER)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]

  @@index([status])
}

enum TenantPlan {
  TRIAL
  STARTER
  GROWTH
  OPERATOR
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// ============================================================
// Brokerage — Section 90 (Customs Act 1967)
// ============================================================

model Accreditation {
  id                 String              @id @default(cuid())
  tenantId           String              @unique
  licenceNumber      String              @unique
  ejenType           EjenType
  status             AccreditationStatus @default(ACTIVE)
  approvalPeriod     String              // "1-year" | "2-year" | "5-year"
  issuedAt           DateTime
  expiresAt          DateTime
  renewalFiled       Boolean             @default(false)

  paidUpCapital      Decimal             @db.Decimal(14, 2)
  capitalRequired    Decimal             @db.Decimal(14, 2)
  registrationType   String              // "business-act-1956" | "companies-act-2016"

  serviceTaxReg      String?
  bondAmount         Decimal             @default(10000) @db.Decimal(14, 2)
  bondExpiresAt      DateTime?

  bumiputeraRequired Boolean             @default(false)
  bumiputeraActual   Int?
  bumiputeraThreshold Int?

  outstandingTax     Boolean             @default(false)
  hangingFormsCount  Int                 @default(0)

  certificateHolders CertificateHolder[]
  approvedStaff      ApprovedStaff[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

enum EjenType {
  PENGHANTARAN      // Forwarding Agent
  PERKAPALAN        // Shipping Agent
  PENGANGKUT_BARANG // Freight Forwarder
}

enum AccreditationStatus {
  ACTIVE
  EXPIRING_SOON
  RENEWAL_FILED
  RENEWAL_OVERDUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model CertificateHolder {
  id             String   @id @default(cuid())
  accreditationId String
  accreditation  Accreditation @relation(fields: [accreditationId], references: [id], onDelete: Cascade)
  name           String
  icNumber       String
  role           String   // "director" | "owner" | "manager" | "employee"
  courseType     String   // "KEK" | "KEP"
  certificateNum String
  issuedAt       DateTime
  active         Boolean  @default(true)

  @@index([accreditationId])
}

model ApprovedStaff {
  id             String   @id @default(cuid())
  accreditationId String
  accreditation  Accreditation @relation(fields: [accreditationId], references: [id], onDelete: Cascade)
  name           String
  icNumber       String
  position       String
  authorizedAt   DateTime
  idPassNumber   String?
  idPassStatus   String   @default("active") // "active" | "lost" | "returned" | "pending"

  @@index([accreditationId])
}

// ============================================================
// Clients
// ============================================================

model Client {
  id                 String       @id @default(cuid())
  tenantId           String
  name               String
  registrationNumber String
  country            String
  tier               String       @default("starter")
  status             String       @default("active")
  sla                String       @default("standard")
  registeredState    String
  contactEmail       String
  monthlyVolume      Int          @default(0)

  authWritten        Boolean      @default(false)
  authReference      String?
  authSignedAt       DateTime?
  authSignedBy       String?

  declarations       Declaration[]

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([tenantId])
  @@index([status])
}

// ============================================================
// Declarations
// ============================================================

model Declaration {
  id                 String              @id @default(cuid())
  tenantId           String
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id])
  reference          String              @unique
  customsReference   String?
  formCode           String              // "K1" | "K2" | "K3" | "K7" | "K8" | "K9"
  type               String              // "import" | "export" | "transit" | "transhipment" | "bonded"
  status             String              @default("draft")
  jurisdiction       String              @default("MY")
  port               String

  totalDeclaredValue Decimal             @db.Decimal(18, 2)
  currency           String              @default("MYR")
  totalDuty          Decimal             @default(0) @db.Decimal(18, 2)
  totalSalesTax      Decimal             @default(0) @db.Decimal(18, 2)
  totalExcise        Decimal             @default(0) @db.Decimal(18, 2)

  owningBroker       String
  borangCReference   String?
  draftedBy          String?
  draftConfidence    Float?
  slaDeadline        DateTime?

  lineItems          DeclarationLineItem[]
  approvals          DeclarationApproval[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([formCode])
}

model DeclarationLineItem {
  id             String      @id @default(cuid())
  declarationId  String
  declaration    Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  description    String
  hsCode         String
  hsConfidence   Float
  quantity       Decimal     @db.Decimal(14, 3)
  unit           String
  unitValue      Decimal     @db.Decimal(18, 2)
  totalValue     Decimal     @db.Decimal(18, 2)
  currency       String      @default("MYR")
  dutyRate       Float?
  dutyAmount     Decimal?    @db.Decimal(18, 2)
  preferenceScheme String?   // "ATIGA" | "RCEP" | "CPTPP" | "none"
  classifiedBy   String      @default("agent")

  @@index([declarationId])
}

model DeclarationApproval {
  id                String      @id @default(cuid())
  declarationId     String
  declaration       Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  actor             String
  role              String
  decision          String      // "approved" | "rejected" | "returned"
  comment           String?
  borangCReference  String?
  at                DateTime    @default(now())

  @@index([declarationId])
}

// ============================================================
// Audit
// ============================================================

model AuditEntry {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  action     String
  actor      String
  hash       String   @unique
  prevHash   String
  payload    Json?
  at         DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([at])
}
