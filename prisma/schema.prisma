// prisma/schema.prisma
//
// Base schema. Extend with your domain models as you build out routers.
// After editing:
//   npx prisma generate
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Auth
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  verifications VerificationToken[]

  @@index([tenantId])
  @@index([role])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPS_MANAGER
  WAREHOUSE_STAFF
  CUSTOMER
  AGENT
  AUDITOR
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
}

// ============================================================
// Tenancy
// ============================================================

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  plan      TenantPlan   @default(STARTER)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]

  @@index([status])
}

enum TenantPlan {
  TRIAL
  STARTER
  GROWTH
  OPERATOR
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// ============================================================
// Brokerage — Section 90 (Customs Act 1967)
// ============================================================

model Accreditation {
  id                 String              @id @default(cuid())
  tenantId           String              @unique
  licenceNumber      String              @unique
  ejenType           EjenType
  status             AccreditationStatus @default(ACTIVE)
  approvalPeriod     String              // "1-year" | "2-year" | "5-year"
  issuedAt           DateTime
  expiresAt          DateTime
  renewalFiled       Boolean             @default(false)

  paidUpCapital      Decimal             @db.Decimal(14, 2)
  capitalRequired    Decimal             @db.Decimal(14, 2)
  registrationType   String              // "business-act-1956" | "companies-act-2016"

  serviceTaxReg      String?
  bondAmount         Decimal             @default(10000) @db.Decimal(14, 2)
  bondExpiresAt      DateTime?

  bumiputeraRequired Boolean             @default(false)
  bumiputeraActual   Int?
  bumiputeraThreshold Int?

  outstandingTax     Boolean             @default(false)
  hangingFormsCount  Int                 @default(0)

  certificateHolders CertificateHolder[]
  approvedStaff      ApprovedStaff[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

enum EjenType {
  PENGHANTARAN      // Forwarding Agent
  PERKAPALAN        // Shipping Agent
  PENGANGKUT_BARANG // Freight Forwarder
}

enum AccreditationStatus {
  ACTIVE
  EXPIRING_SOON
  RENEWAL_FILED
  RENEWAL_OVERDUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model CertificateHolder {
  id             String   @id @default(cuid())
  accreditationId String
  accreditation  Accreditation @relation(fields: [accreditationId], references: [id], onDelete: Cascade)
  name           String
  icNumber       String
  role           String   // "director" | "owner" | "manager" | "employee"
  courseType     String   // "KEK" | "KEP"
  certificateNum String
  issuedAt       DateTime
  active         Boolean  @default(true)

  @@index([accreditationId])
}

model ApprovedStaff {
  id             String   @id @default(cuid())
  accreditationId String
  accreditation  Accreditation @relation(fields: [accreditationId], references: [id], onDelete: Cascade)
  name           String
  icNumber       String
  position       String
  authorizedAt   DateTime
  idPassNumber   String?
  idPassStatus   String   @default("active") // "active" | "lost" | "returned" | "pending"

  @@index([accreditationId])
}

// ============================================================
// Clients
// ============================================================

model Client {
  id                 String       @id @default(cuid())
  tenantId           String
  name               String
  registrationNumber String
  country            String
  tier               String       @default("starter")
  status             String       @default("active")
  sla                String       @default("standard")
  registeredState    String
  contactEmail       String
  monthlyVolume      Int          @default(0)

  authWritten        Boolean      @default(false)
  authReference      String?
  authSignedAt       DateTime?
  authSignedBy       String?

  declarations       Declaration[]

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([tenantId])
  @@index([status])
}

// ============================================================
// Declarations
// ============================================================

model Declaration {
  id                 String              @id @default(cuid())
  tenantId           String
  clientId           String
  client             Client              @relation(fields: [clientId], references: [id])
  reference          String              @unique
  customsReference   String?
  formCode           String              // "K1" | "K2" | "K3" | "K7" | "K8" | "K9"
  type               String              // "import" | "export" | "transit" | "transhipment" | "bonded"
  status             String              @default("draft")
  jurisdiction       String              @default("MY")
  port               String

  totalDeclaredValue Decimal             @db.Decimal(18, 2)
  currency           String              @default("MYR")
  totalDuty          Decimal             @default(0) @db.Decimal(18, 2)
  totalSalesTax      Decimal             @default(0) @db.Decimal(18, 2)
  totalExcise        Decimal             @default(0) @db.Decimal(18, 2)

  owningBroker       String
  borangCReference   String?
  draftedBy          String?
  draftConfidence    Float?
  slaDeadline        DateTime?

  lineItems          DeclarationLineItem[]
  approvals          DeclarationApproval[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@index([formCode])
}

model DeclarationLineItem {
  id             String      @id @default(cuid())
  declarationId  String
  declaration    Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  description    String
  hsCode         String
  hsConfidence   Float
  quantity       Decimal     @db.Decimal(14, 3)
  unit           String
  unitValue      Decimal     @db.Decimal(18, 2)
  totalValue     Decimal     @db.Decimal(18, 2)
  currency       String      @default("MYR")
  dutyRate       Float?
  dutyAmount     Decimal?    @db.Decimal(18, 2)
  preferenceScheme String?   // "ATIGA" | "RCEP" | "CPTPP" | "none"
  classifiedBy   String      @default("agent")

  @@index([declarationId])
}

model DeclarationApproval {
  id                String      @id @default(cuid())
  declarationId     String
  declaration       Declaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)
  actor             String
  role              String
  decision          String      // "approved" | "rejected" | "returned"
  comment           String?
  borangCReference  String?
  at                DateTime    @default(now())

  @@index([declarationId])
}

// ============================================================
// Audit
// ============================================================

model AuditEntry {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  action     String
  actor      String
  hash       String   @unique
  prevHash   String
  payload    Json?
  at         DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([at])
}

// ─────────────────────────────────────────────────────────
// DIGITAL TWIN — Core entities
// Aligned with GB/T 46237-2025 maturity levels and
// Gartner 2026 DTO capabilities (agentic, closed-loop,
// governed, real-time) [citation:3][citation:15]
// ─────────────────────────────────────────────────────────

model Zone {
  id            String   @id @default(cuid())
  code          String   @unique        // "FIZ-01", "FCZ-02"
  name          String
  kind          ZoneKind
  parentId      String?
  parent        Zone?    @relation("ZoneHierarchy", fields: [parentId], references: [id])
  children      Zone[]   @relation("ZoneHierarchy")

  // 2026 additions — semantic + governance layers
  geojson       Json?                    // boundary polygon
  jurisdiction  String   @default("MY")
  operatingHours Json?
  maturityLevel MaturityLevel @default(L1_CONNECTED)

  nodes         TwinNode[]
  scenarios     Scenario[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ZoneKind {
  FIZ          // Free Industrial Zone
  FCZ          // Free Commercial Zone
  BONDED       // Licensed bonded warehouse
  GATE         // Port / airport gate
  CFS          // Container freight station
  MISC
}

enum MaturityLevel {
  L0_MANUAL
  L1_CONNECTED       // sensors → dashboard
  L2_INTELLIGENT     // AI-assisted decisions [citation:2]
  L3_AUTONOMOUS      // closed-loop agents [citation:4]
}

// ─────────────────────────────────────────────────────────
// TWIN NODES — the graph vertices
// ─────────────────────────────────────────────────────────

model TwinNode {
  id            String   @id @default(cuid())
  zoneId        String
  zone          Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  kind          NodeKind
  label         String
  positionX     Float
  positionY     Float

  // Live state — 2026: real-time sync via Prisma Pulse [citation:15]
  status        NodeStatus @default(IDLE)
  metrics       Json?                    // { throughput, dwell, utilization, cost }
  lastPulseAt   DateTime?
  semanticType  String?                  // knowledge-graph type [citation:14]

  // Agent binding — 2026: semi-autonomous agents per node [citation:4]
  agentId       String?
  agent         TwinAgent? @relation(fields: [agentId], references: [id])

  // Policy binding
  policyId      String?
  policy        Policy?    @relation(fields: [policyId], references: [id])

  edgesFrom     TwinEdge[] @relation("EdgeSource")
  edgesTo       TwinEdge[] @relation("EdgeTarget")
  events        TwinEvent[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([zoneId, kind])
  @@index([status])
}

enum NodeKind {
  ZONE
  AGENT
  TASK
  GATE
  MOVEMENT
  RESOURCE      // 2026: discrete resources (forklifts, inspectors) [citation:16]
  BUFFER        // 2026: continuous quantities (fuel, inventory) [citation:5]
}

enum NodeStatus {
  IDLE
  ACTIVE
  BLOCKED
  DONE
  ERROR
}

// ─────────────────────────────────────────────────────────
// TWIN EDGES — the graph connections
// ─────────────────────────────────────────────────────────

model TwinEdge {
  id            String   @id @default(cuid())
  sourceId      String
  source        TwinNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId      String
  target        TwinNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  kind          EdgeKind @default(FLOW)
  label         String?
  volume        Float?
  semanticRel   String?                  // knowledge-graph predicate [citation:14]

  createdAt     DateTime @default(now())

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

enum EdgeKind {
  FLOW          // material / data movement
  HANDOFF       // agent-to-agent [citation:15]
  DEPENDENCY    // task depends on task
  SEMANTIC      // knowledge-graph relation
}

// ─────────────────────────────────────────────────────────
// SCENARIOS — what-if simulation configurations
// ─────────────────────────────────────────────────────────

model Scenario {
  id            String   @id @default(cuid())
  zoneId        String
  zone          Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  parameters    Json     // { demandMultiplier: 1.2, gateCapacity: 8, ... }
  tags          String[]

  runs          Run[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([zoneId])
}

// ─────────────────────────────────────────────────────────
// RUNS — execution instances
// ─────────────────────────────────────────────────────────

model Run {
  id            String   @id @default(cuid())
  scenarioId    String
  scenario      Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  status        RunStatus @default(RUNNING)
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  stepIndex     Int      @default(0)
  totalSteps    Int      @default(240)

  // Aggregated metrics at end of run
  finalMetrics  Json?

  events        TwinEvent[]
  agentRuns     AgentRun[]

  @@index([scenarioId, status])
}

enum RunStatus {
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────
// TWIN EVENTS — append-only event log
// 2026: feeds audit + agent learning loop [citation:15]
// ─────────────────────────────────────────────────────────

model TwinEvent {
  id            String   @id @default(cuid())
  nodeId        String?
  node          TwinNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  runId         String?
  run           Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  kind          EventKind
  severity      Severity @default(INFO)
  message       String
  payload       Json?
  occurredAt    DateTime @default(now())

  @@index([nodeId, occurredAt])
  @@index([runId, occurredAt])
  @@index([severity, occurredAt])
}

enum EventKind {
  LOG
  ALERT
  METRIC
  AGENT_ACTION
  POLICY_DECISION
  HUMAN_INTERVENTION
}

enum Severity {
  INFO
  WARN
  ERROR
  CRITICAL
}

// ─────────────────────────────────────────────────────────
// TWIN AGENTS — semi-autonomous actors [citation:4][citation:15]
// ─────────────────────────────────────────────────────────

model TwinAgent {
  id            String   @id @default(cuid())
  name          String
  role          String                    // "gate-dispatcher", "dwell-optimizer"
  kind          AgentKind

  // Registry — 2026: versioned, governed agent lifecycle [citation:15]
  version       String   @default("1.0.0")
  status        AgentStatus @default(ACTIVE)

  // Capability model
  capabilities  String[]
  guardrails    Json?                    // { maxSpend: 1000, jurisdictions: ["MY"] }

  // Bindings
  nodes         TwinNode[]
  agentRuns     AgentRun[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum AgentKind {
  SUPERVISOR
  WORKER
  CRITIC
  ROUTER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  DEPRECATED
}

// ─────────────────────────────────────────────────────────
// AGENT RUNS — auditable agent executions [citation:15]
// ─────────────────────────────────────────────────────────

model AgentRun {
  id            String   @id @default(cuid())
  agentId       String
  agent         TwinAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runId         String?
  run           Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  status        RunStatus @default(RUNNING)
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  input         Json?
  output        Json?
  reasoning     Json?                    // explainability payload [citation:2]

  @@index([agentId, startedAt])
}

// ─────────────────────────────────────────────────────────
// POLICY — governance layer [citation:15]
// ─────────────────────────────────────────────────────────

model Policy {
  id            String   @id @default(cuid())
  name          String
  description   String?

  rulePack      Json                     // structured rules
  jurisdiction  String   @default("MY")
  severity      Severity @default(WARN)

  nodes         TwinNode[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}