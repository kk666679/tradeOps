# syntax=docker/dockerfile:1.7
# TradeOps CFS WMS — Web tier (Next.js 16 standalone output)
# Build:  docker build -t cfs-wms:web -f Dockerfile.web .
# Run:    docker run -p 3000:3000 cfs-wms:web
FROM node:20-alpine AS base

# ----------
# Dependencies
# ----------
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --ignore-scripts
# Prisma needs the schema + config to generate the client during install.
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm run prisma generate

# ----------
# Builder
# ----------
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/backend/node_modules ./backend/node_modules
COPY --from=deps /app/node_modules/@prisma ./node_modules/@prisma
COPY . .
RUN npm run build

# ----------
# Runner (production)
# ----------
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Next.js requires the public directory at runtime for images/assets.
RUN chown -R nextjs:nodejs /app

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]